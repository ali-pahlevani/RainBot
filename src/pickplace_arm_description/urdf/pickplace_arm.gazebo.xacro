<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ros2_control system for Gazebo Harmonic. This is the only ros2_control
       system in the description: the Husky A200 is included with
       use_platform_controllers:=false and is_sim:=false. -->
  <ros2_control name="pickplace_arm_system" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- FR3 arm. initial_value spawns the arm in Franka's own "ready" pose:
         elbow bent, clear of the shoulder singularity and the Husky's top plate. -->
    <joint name="fr3_joint1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="fr3_joint2">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-0.7854</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="fr3_joint3">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="fr3_joint4">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-2.3562</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="fr3_joint5">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="fr3_joint6">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">1.5708</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="fr3_joint7">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.7854</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <!-- Franka Hand. Only finger_joint1 is commanded; finger_joint2 mimics it via
         gz_ros2_control's own mimic/multiplier <param> tags. -->
    <joint name="fr3_finger_joint1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.04</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="fr3_finger_joint2">
      <param name="mimic">fr3_finger_joint1</param>
      <param name="multiplier">1.0</param>
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.04</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <!-- Husky A200 wheels. The A200 macro names its wheel joints exactly as the
         old placeholder base did, so diff_drive_controller's joint lists carry
         over unchanged (its wheel_separation/wheel_radius do not). -->
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Gazebo Harmonic gz_ros2_control plugin -->
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find pickplace_arm_description)/config/arm_controllers.yaml</parameters>
      <ros>
    <!-- Emitted only when robot_ns is set: an empty <namespace/> is not the same
         as no namespace to the plugin. -->
        <xacro:if value="${robot_ns != ''}">
          <namespace>${robot_ns}</namespace>
        </xacro:if>
        <remapping>~/robot_description:=${ns_topic}/robot_description</remapping>
      </ros>
    </plugin>
  </gazebo>

  <!-- Rigid grasp: weld the box to the gripper instead of relying on friction,
       which was never reliable through a carry. -->
  <xacro:macro name="grasp_attach" params="model">
    <gazebo>
      <plugin filename="gz-sim-detachable-joint-system"
              name="gz::sim::systems::DetachableJoint">
        <parent_link>fr3_link7</parent_link>
        <child_model>${model}</child_model>
        <child_link>link</child_link>
        <attach_topic>${ns_topic}/${model}/attach</attach_topic>
        <detach_topic>${ns_topic}/${model}/detach</detach_topic>
        <output_topic>${ns_topic}/${model}/attach_state</output_topic>
        <suppress_child_warning>true</suppress_child_warning>
      </plugin>
    </gazebo>
  </xacro:macro>
  <!-- The coloured boxes of the warehouse run. -->
  <xacro:grasp_attach model="box_red"/>
  <xacro:grasp_attach model="box_green"/>
  <xacro:grasp_attach model="box_blue"/>
  <!-- The sample racks of the hospital run. Declared unconditionally like the
       boxes: suppress_child_warning makes a plugin whose child model is absent
       from this world harmless, so one description serves both missions. -->
  <xacro:grasp_attach model="rack_red"/>
  <xacro:grasp_attach model="rack_green"/>
  <xacro:grasp_attach model="rack_blue"/>

  <!-- High friction + soft contact on the finger pads so the gripper can hold a
       box by friction in Gazebo Harmonic. -->
  <gazebo reference="fr3_leftfinger">
    <mu1>5.0</mu1>
    <mu2>5.0</mu2>
    <kp>1e6</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.0</maxVel>
  </gazebo>
  <gazebo reference="fr3_rightfinger">
    <mu1>5.0</mu1>
    <mu2>5.0</mu2>
    <kp>1e6</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.0</maxVel>
  </gazebo>

  <!-- Wheel ground contact friction, enough traction to drive/skid-steer
       without excessive slip. Link names come from the A200 macro. -->
  <xacro:macro name="wheel_friction" params="link">
    <gazebo reference="${link}">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1e6</kp>
      <kd>1.0</kd>
      <minDepth>0.001</minDepth>
    </gazebo>
  </xacro:macro>
  <xacro:wheel_friction link="front_left_wheel"/>
  <xacro:wheel_friction link="front_right_wheel"/>
  <xacro:wheel_friction link="rear_left_wheel"/>
  <xacro:wheel_friction link="rear_right_wheel"/>

  <!-- Wrist RGB-D camera sensor. camera_link is fixed to fr3_hand but survives
       the URDF->SDF fixed-joint merge because it carries a sensor. -->
  <xacro:if value="$(arg wrist_camera)">
    <gazebo reference="camera_link">
      <sensor name="rgbd_camera" type="rgbd_camera">
        <topic>${ns_topic}/camera</topic>
        <update_rate>5</update_rate>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>5.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <gz_frame_id>${ns_frame}camera_link</gz_frame_id>
      </sensor>
    </gazebo>
  </xacro:if>

  <!-- 2D LIDAR sensor (Gazebo Harmonic gpu_lidar) for SLAM + Nav2 -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>${ns_topic}/scan</topic>
      <update_rate>15</update_rate>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>270</samples>
            <resolution>1</resolution>
            <min_angle>-1.65806279</min_angle>
            <max_angle>1.65806279</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>25.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <gz_frame_id>${ns_frame}lidar_link</gz_frame_id>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>${ns_topic}/imu</topic>
      <update_rate>50</update_rate>
      <always_on>1</always_on>
      <gz_frame_id>${ns_frame}imu_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- Front RGB-D camera: detects the box ahead while the base drives. -->
  <gazebo reference="front_camera_link">
    <sensor name="front_rgbd_camera" type="rgbd_camera">
      <topic>${ns_topic}/front_camera</topic>
      <update_rate>10</update_rate>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.57</horizontal_fov>
        <image>
          <width>320</width>
          <height>320</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <gz_frame_id>${ns_frame}front_camera_link</gz_frame_id>
    </sensor>
  </gazebo>

</robot>
