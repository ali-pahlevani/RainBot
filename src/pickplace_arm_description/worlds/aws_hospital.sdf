<?xml version='1.0' encoding='ASCII'?>
<!-- AWS RoboMaker hospital, one floor, ported to Gazebo Harmonic.

     Geometry is AWS's, unchanged: 183 model instances over a building roughly
     25 m x 51 m, with real interior walls, a floor and a ceiling. Licence and
     attribution sit with the meshes in aws_hospital_models/.

     Generated from the archived hospital.world (the aws-robotics repo's `ros1`
     branch). Only what Classic and Harmonic disagree about changed in the port:
     the world header, the ground plane and sun, and how model URIs resolve.

     Run it with the resource path pointing at the vendored models:
         WORLD=aws_hospital.sdf ros2 launch pickplace_arm_description gazebo.launch.py

     The ceiling blocks any view from above. It is the last model in the file
     and named `hospital_ceiling`, so it can be unticked in the entity tree. -->
<sdf version='1.7'>
  <world name='aws_hospital'>
    <gravity>0 0 -9.8</gravity>
    <physics type='ode'>
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <max_contacts>10</max_contacts>
    </physics>
    <plugin name='ignition::gazebo::systems::Physics' filename='libignition-gazebo-physics-system.so'/>
    <plugin name='ignition::gazebo::systems::UserCommands' filename='libignition-gazebo-user-commands-system.so'/>
    <plugin name='ignition::gazebo::systems::SceneBroadcaster' filename='libignition-gazebo-scene-broadcaster-system.so'/>
    <plugin name='ignition::gazebo::systems::Imu' filename='ignition-gazebo-imu-system'/>
    <plugin name='ignition::gazebo::systems::Sensors' filename='ignition-gazebo-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>0</shadows>
      <grid>false</grid>
    </scene>

  <!-- Indoors under a ceiling, so the sun is a fill light rather than a
       shadow-caster; shadows are off for real-time factor. -->
    <light type="directional" name="sun">
      <cast_shadows>0</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>0.2 0.2 -1</direction>
    </light>

    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane><normal>0.0 0.0 1</normal><size>1 1</size></plane>
          </geometry>
        </collision>
      </link>
      <pose>0 0 0 0 0 0</pose>
    </model>

    <include>
    <name>aws_robomaker_hospital_floor_01_floor</name>
    <uri>model://aws_robomaker_hospital_floor_01_floor</uri>
    <static>true</static>
    <pose>-0.001425 -0.014447 0 0 -0 0</pose>
    </include>
    <include>
    <name>aws_robomaker_hospital_floor_01_walls</name>
    <uri>model://aws_robomaker_hospital_floor_01_walls</uri>
