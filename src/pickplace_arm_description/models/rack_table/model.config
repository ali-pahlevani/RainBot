<?xml version="1.0"?>
<!-- Present so the table can also be pulled in by model://rack_table, not only
     spawned by file path the way the mission launch does it. -->
<model>
  <name>rack_table</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Table a blood sample rack stands on: a vendored clone of AWS RoboMaker's
    residential CoffeeTable_01, chosen because its 0.32 m top is the only one in
    this world the FR3 can reach a rack on. Original licence and attribution sit
    with aws_hospital_models.
  </description>
</model>
