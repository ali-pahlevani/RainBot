<?xml version="1.0"?>
<!-- Present so the rack can also be pulled in by model://rack_red, not only
     spawned by file path the way the mission launch does it. -->
<model>
  <name>rack_red</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Blood sample rack, red channel: six capped tubes in a carrier with a
    0.06 m red grip block sized to the Franka Hand. Stands in for box_red
    in the pick-and-place run.
  </description>
</model>
